# Public - safe to expose to the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only - NEVER prefix with NEXT_PUBLIC_, NEVER import from client code.
# Required by backend.ts for domain/Storage operations AFTER session validation.
# Never pass it to createBrowserClient, cookies, API responses, or client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
