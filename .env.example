# Public - safe to expose to the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only - NEVER prefix with NEXT_PUBLIC_, NEVER import from client code.
# Required by backend.ts for domain/Storage operations AFTER session validation.
# Never pass it to createBrowserClient, cookies, API responses, or client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# B4 - server-only. Supply credentials in the deployment environment.
AI_PROVIDER=openrouter
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
# For OpenAI: AI_PROVIDER=openai and AI_BASE_URL=https://api.openai.com/v1
# No default/hardcoded model: choose IDs supported by the configured provider.
AI_INTERPRETER_MODEL=
AI_INTERPRETER_TIMEOUT_MS=180000
AI_INTERPRETER_MAX_OUTPUT_TOKENS=12000
AI_CLASSIFIER_MODEL=
AI_CLASSIFIER_TIMEOUT_MS=45000
AI_CLASSIFIER_MAX_OUTPUT_TOKENS=2000

# Precedence: explicit stage setting > legacy setting > per-stage default above.
# Interpreter model: AI_INTERPRETER_MODEL > AI_MODEL (required; no default).
# Classifier model: AI_CLASSIFIER_MODEL > AI_MODEL > resolved interpreter model.
# Optional legacy variables: AI_MODEL, AI_TIMEOUT_MS, AI_MAX_OUTPUT_TOKENS.
# Remove unused variables: an explicitly empty model/timeout/token value is invalid.
# Never use NEXT_PUBLIC_ for AI keys/configuration. No secrets belong in this file.
